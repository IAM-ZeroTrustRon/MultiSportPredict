# Discord Webhook Configuration
# Get your webhook URL from Discord:
# 1. Go to your Discord server settings
# 2. Navigate to Integrations > Webhooks
# 3. Create a new webhook in your chosen channel
# 4. Copy the webhook URL and paste it below
DISCORD_WEBHOOK_URL=https://discordapp.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN

# Dedicated webhook for automated recommendation embeds (e.g. tennis picks)
DISCORD_RECOMMENDATIONS_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_RECOMMENDATIONS_WEBHOOK_ID/YOUR_RECOMMENDATIONS_WEBHOOK_TOKEN

# The Odds API Key (optional, for live odds integration)
ODDS_API_KEY=your_odds_api_key_here
